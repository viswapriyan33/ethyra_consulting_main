# ==============================================================================
# Ethyra Consulting Services - Apache / LiteSpeed Server Security Configuration
# Protects hidden files, blocks sensitive extensions, and enforces HTTP Security Headers.
# ==============================================================================

# 1. Prevent Directory Indexing (Don't let anyone list files in folders)
Options -Indexes

# 2. Block Direct Web Access to Hidden Files (e.g. .git, .gitignore, .env)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Block Direct Web Access to Sensitive Source & Backup Extensions
<FilesMatch "\.(bak|backup|old|orig|sql|sqlite|db|dump|log|env|py|sh|md|txt)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Allow humans / search engines to view standard robots and sitemap if present
<Files "robots.txt">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</Files>

# 4. HTTP Security Headers
<IfModule mod_headers.c>
    # Prevent MIME Sniffing attacks
    Header set X-Content-Type-Options "nosniff"

    # Prevent Clickjacking (disallow embedding inside foreign iframes)
    Header set X-Frame-Options "SAMEORIGIN"

    # Legacy XSS Protection for older browsers
    Header set X-XSS-Protection "1; mode=block"

    # Referrer Policy: only send referrer to the same origin; send origin only on cross-origin HTTPS
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Restrict risky browser features
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # Enforce HTTPS (HSTS) - Enabled for 1 year with subdomains
    <If "%{HTTPS} == 'on'">
        Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    </If>
</IfModule>
